programa {
  funcao inicio() {
    inteiro numero [4] = {10, 5, 7, 8}

    inteiro soma = numero [0] + numero [3]
    escreva("soma dos numeros na posicao 0 e 3: " ,soma,"\n")

    inteiro multiplicacao = numero [1] * numero [2]
    escreva("A multiplicacao dos numeros na posiçao 1 e 2 é: ", multiplicacao,"\n")

    inteiro diferenca = numero [2] - numero [0]

    escreva("A diferenca entre os numeros na posiçao 2 e 0 é de: ", diferenca,"\n")
    
  }
}
