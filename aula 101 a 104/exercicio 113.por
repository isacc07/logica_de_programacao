programa {
  funcao inicio() {
    inteiro numeros [5]
    
    escreva("Informe o valor: ")
    leia(numeros [0])
    escreva(numeros [0],"\n")

    escreva("Informe o valor: ")
    leia(numeros [1])
    escreva(numeros [1],"\n")

    escreva("Informe o valor: ")
    leia(numeros [2])
    escreva(numeros [2],"\n")

    numeros [3] = 50
    numeros [4] = 70

    escreva(numeros [0],"\n")
    escreva (numeros [1],"\n")
    escreva(numeros [2],"\n")
    escreva (numeros [3],"\n")
    escreva(numeros [4],"\n")
  }
}
